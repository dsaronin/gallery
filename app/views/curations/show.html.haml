.curation-page
  .page-header.curation-header-card
    .header-left
      %h2= "Curate: #{@curatable.title}"
    .header-center
      = turbo_frame_tag "curation_status" do
        = render "curation_status"
    .header-right
      = button_to "« Portfolios", @curatable, method: :get, class: "btn btn-outline"
      = button_to "Clear", url_for([:clear, @curatable, :curation]), method: :delete, class: "btn btn-outline"
      = button_tag "Preview", type: "submit", form: "curation-filter-form", class: "btn btn-secondary"
      = turbo_frame_tag "curation_actions" do
        = render "curation_actions"

  .curation-layout
    .curation-sidebar-pane
      = render "filters_sidebar"
    .curation-workspace-pane
      = render "candidate_grid"
