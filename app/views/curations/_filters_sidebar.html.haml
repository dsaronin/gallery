.curation-sidebar
  = form_with url: url_for([:preview, @curatable, :curation]), method: :post, id: "curation-filter-form", data: { turbo_frame: "curation_preview" }, class: "curation-form" do |f|
    .filter-group.criteria-scalars
      .field
        = label_tag "curation_criteria_date_range_start_date", "From"
        = date_field_tag "curation_criteria[date_range][start_date]", @criteria.start_date&.strftime("%Y-%m-%d"), class: "form-control"
      .field
        = label_tag "curation_criteria_date_range_end_date", "To"
        = date_field_tag "curation_criteria[date_range][end_date]", @criteria.end_date&.strftime("%Y-%m-%d"), class: "form-control"
      .field.star-filter-field
        = label_tag "curation_criteria_min_stars", "Stars"
        = hidden_field_tag "curation_criteria[min_stars]", @criteria.min_stars, id: "curation_criteria_min_stars"
        .filter-star-bar{ data_controller: "star-filter" }
          %button.filter-star-btn{ type: "button", title: "Any", onclick: "document.getElementById('curation_criteria_min_stars').value = ''; document.querySelectorAll('.filter-star-btn').forEach(b => b.classList.remove('active'));" }
            ∅
          - (1..5).each do |s|
            %button.filter-star-btn{ type: "button", class: ("active" if @criteria.min_stars.to_i >= s), title: "#{s} Stars", onclick: "document.getElementById('curation_criteria_min_stars').value = '#{s}'; document.querySelectorAll('.filter-star-btn').forEach((b, idx) => { if(idx > 0) { b.classList.toggle('active', idx <= #{s}); } });" }
              ★

    - if @talents.any?
      .filter-group.filter-group-talent
        %h4 Talent
        .checkbox-list.scroll-pane.scroll-pane-left
          .scroll-pane-inner
            - @talents.each do |talent|
              %label.checkbox-label
                = check_box_tag "curation_criteria[talent_ids][]", talent.id, @criteria.talent_ids.include?(talent.id)
                = talent.talent_name

    - if @categories.any?
      .filter-group.filter-group-tags
        %h4 Tags
        .scroll-pane.scroll-pane-right
          .scroll-pane-inner
            - @categories.each do |category|
              - if category.tags.any?
                .category-section
                  %strong= category.name
                  .checkbox-list
                    - category.tags.each do |tag|
                      %label.checkbox-label
                        = check_box_tag "curation_criteria[tag_ids][]", tag.id, @criteria.tag_ids.include?(tag.id)
                        = tag.name

    - if @portfolios.any? || @exhibitions.any? || @catalogs.any?
      .filter-group.filter-group-sources
        %h4 Curations
        .scroll-pane.scroll-pane-right
          .scroll-pane-inner
            - if @portfolios.any?
              .category-section
                %strong Portfolios
                .checkbox-list
                  - @portfolios.each do |port|
                    %label.checkbox-label
                      = check_box_tag "curation_criteria[sources][portfolio_ids][]", port.id, @criteria.portfolio_ids.include?(port.id)
                      = port.title.presence || port.name

            - if @exhibitions.any?
              .category-section
                %strong Exhibitions
                .checkbox-list
                  - @exhibitions.each do |exh|
                    %label.checkbox-label
                      = check_box_tag "curation_criteria[sources][exhibition_ids][]", exh.id, @criteria.exhibition_ids.include?(exh.id)
                      = exh.title

            - if @catalogs.any?
              .category-section
                %strong Catalogs
                .checkbox-list
                  - @catalogs.each do |cat|
                    %label.checkbox-label
                      = check_box_tag "curation_criteria[sources][catalog_ids][]", cat.id, @criteria.catalog_ids.include?(cat.id)
                      = cat.name.presence || cat.fname

