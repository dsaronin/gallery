%h4 Tag & Category Management

.actionbox-section
  %h5 Add New Category
  = form_with model: @new_category, url: category_index_path do |f|
    = f.text_field :name, placeholder: "Category name"
    = f.submit "Add Category &raquo;".html_safe, class: "btn"

.actionbox-section
  %h5 Add New Tag
  - if @categories.empty?
    %p Create a category before adding tags.
  - else
    = form_with model: @new_tag, url: tag_index_path do |f|
      %label{ for: "tag_category_id" } Select category:
      = f.collection_select :category_id, @categories, :id, :name, { selected: @selected_category_id }
      = f.text_field :name, placeholder: "Tag name"
      %label
        = f.check_box :theme
        Theme Tag
      = f.submit "Add Tag &raquo;".html_safe, class: "btn"

%hr

%h5 Existing Categories & Tags
.list
  - if @categories.empty?
    %p No categories or tags defined yet.
  - else
    - @categories.each do |cat|
      .category-block
        %strong= cat.name
        &ensp;
        = link_to "[delete]", category_path(cat), data: { turbo_method: :delete, turbo_confirm: "Delete category '#{cat.name}' and all its tags?" }, class: "delete-link"
        
        - if cat.tags.empty?
          %p.empty-notice &emsp;(No tags in this category)
        - else
          %ul
            - cat.tags.each do |tag|
              %li
                = tag.name
                - if tag.theme?
                  %span.theme-indicator [theme]
                &ensp;
                = link_to "&times;".html_safe, tag_path(tag), data: { turbo_method: :delete, turbo_confirm: "Delete tag '#{tag.name}'?" }, class: "delete-tag", title: "Delete tag"


