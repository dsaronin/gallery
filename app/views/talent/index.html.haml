.view-container#talent-index-view
  - if @target_catalog.present?
    .assignment-context-bar
      .context-message
        Assigning Talent to Catalog:
        %strong= @target_catalog.name
      .context-actions
        - if @target_catalog.talent_id.present?
          = button_to "Remove Assigned Talent", catalog_path(@target_catalog, catalog: { talent_id: nil }), method: :patch, class: "btn-remove-talent"
        = link_to "Cancel", catalog_index_path, class: "btn-cancel-assignment"

  .view-header
    .view-title-group
      %h3.view-title= @target_catalog.present? ? "Select Talent" : "Talents"
      = link_to "⊞", root_path, class: "header-home", title: "Dashboard"
      - unless @target_catalog.present?
        = link_to "+", new_talent_path, class: "header-fab", title: "New Talent"

    %span.view-count= "#{@talents.size} #{'model'.pluralize(@talents.size)}"

  - if @talents.blank?
    .empty-notice
      %p No talents registered.
  - else
    .talent-card-grid
      - @talents.each do |talent|
        = render partial: "talent/card", locals: { talent: talent, target_catalog: @target_catalog }

