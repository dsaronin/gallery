.view-container#talent-index-view
  .view-header
    .view-title-group
      %h3.view-title Talent
      %span.view-count= "#{@talents.size} #{'model'.pluralize(@talents.size)}"

    .view-actions
      = link_to "+ New Talent »", new_talent_path, class: "btn-primary-action"

  - if @talents.blank?
    .empty-notice
      %p No talent records found. Click "+ New Talent »" to add one.
  - else
    .talent-card-grid
      - @talents.each do |talent|
        = render partial: "talent/card", locals: { talent: talent }
