= form_for @talent, html: { class: "material-form" } do |f|
  - if @talent.errors.any?
    .form-error-panel
      %h5= "#{pluralize(@talent.errors.count, 'error')} prevented saving:"
      %ul
        - @talent.errors.full_messages.each do |message|
          %li= message

  .form-grid
    .form-field
      = f.label :talent_code, "Talent Code *"
      = f.text_field :talent_code, required: true, class: "form-input", placeholder: "e.g. TL-01"

    .form-field
      = f.label :talent_name, "Model Name *"
      = f.text_field :talent_name, required: true, class: "form-input", placeholder: "Stage / Portfolio name"

    .form-field
      = f.label :first_name, "First Name *"
      = f.text_field :first_name, required: true, class: "form-input"

    .form-field
      = f.label :last_name, "Last Name"
      = f.text_field :last_name, class: "form-input"

    .form-field
      = f.label :talent_phone, "Contact Phone"
      = f.telephone_field :talent_phone, class: "form-input", placeholder: "(555) 000-0000"

    .form-field
      = f.label :talent_email, "Email Address"
      = f.email_field :talent_email, class: "form-input", placeholder: "talent@example.com"

    .form-field.full-width
      = f.label :talent_address, "Mailing Address"
      = f.text_field :talent_address, class: "form-input", placeholder: "Street, City, State, ZIP"

    .form-field
      = f.label :talent_dob, "Date of Birth"
      = f.date_field :talent_dob, class: "form-input"

    .form-field.full-width
      = f.label :talent_release, "Model Release Date"
      = f.date_field :talent_release, class: "form-input"

  .form-actions-bar
    = link_to "Cancel", (@talent.persisted? ? talent_path(@talent) : talent_index_path), class: "btn-cancel"
    = f.submit (@talent.persisted? ? "Update Talent »" : "Create Talent »"), class: "btn-submit"

