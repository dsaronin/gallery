%h4 Available Folders
%p
  = link_to "Select Folders to Ingest", folder_selectfolder_path, class: "btn"
%i click name to show all pics in folder
.list
  - if @list.empty?
    %p There are no folders to show; select something to load.
  - else
    .column
      %ul
        - @list.each do |f|
          %li= link_to f.fname, f
