= form_for @portfolio, url: (@portfolio.persisted? ? portfolio_path(@portfolio) : portfolio_index_path), html: { class: "material-form" } do |f|
  - if @portfolio.errors.any?
    .form-error-panel
      %h5= "#{pluralize(@portfolio.errors.count, 'error')} prevented saving:"
      %ul
        - @portfolio.errors.full_messages.each do |message|
          %li= message

  .form-grid
    .form-field.full-width
      = f.label :name, "Portfolio Name *"
      = f.text_field :name, required: true, class: "form-input", placeholder: "e.g. sierras_autumn_2026"

    .form-field.full-width
      = f.label :title, "Portfolio Description *"
      = f.text_field :title, required: true, class: "form-input", placeholder: "e.g. Autumn in the High Sierras"

    - if @portfolio.persisted?
      .form-field.full-width
        = f.label :status, "Portfolio Status *"
        = f.select :status, Portfolio.statuses.keys.map { |s| [s.humanize, s] }, {}, { class: "form-input form-select" }

      .form-field.full-width
        = f.label :placard_id, "Portfolio Placard"
        = f.collection_select :placard_id, Placard.order(:title), :id, :title, { include_blank: "Default" }, { class: "form-input form-select" }

  .form-actions-bar
    = link_to "Cancel", (@portfolio.persisted? ? portfolio_path(@portfolio) : portfolio_index_path), class: "btn-cancel"
    = f.submit (@portfolio.persisted? ? "Update Portfolio »" : "Create Portfolio »"), class: "btn-submit"
