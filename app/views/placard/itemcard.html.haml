-# app/views/placard/itemcard.html.haml
- pd = @placard_data
- back_path = @parent_collection ? collection_placard_show_path(@parent_collection) : placard_index_path
- edit_link_path = if @placard.present?
  - edit_placard_path(@placard, target_type: @target&.class&.name, target_id: @target&.id)
- else
  - new_placard_path(target_type: @target&.class&.name, target_id: @target&.id)

.view-container#placard-itemcard-view
  .placard-detail-card
    .card-header-bar
      .header-left
        %h3.placard-title= pd.title.presence || "Untitled"
        = link_to "« back", back_path, class: "header-back-link"
        = link_to "edit", edit_link_path, class: "header-action-link"
        - if @placard.present?
          = button_to placard_path(@placard, target_type: @target&.class&.name, target_id: @target&.id), method: :delete, form_class: "inline-action-form", form: { data: { turbo_confirm: "Remove direct placard overrides and revert to inherited values?" } }, onclick: "return confirm('Remove direct placard overrides and revert to inherited values?')", class: "header-action-link btn-link-action" do
            delete
            %span.clear-glyph ✘
        = link_to "display", target_placard_display_path(@target, @placard), class: "header-action-link primary-action"

      .header-right
        - if @preview_photo
          .card-thumbnail-preview
            %a{ href: photo_path(@preview_photo), title: (@preview_photo.photo_dsc.presence || @preview_photo.filename) }
              %img{ src: public_fn(@preview_photo.filename), class: "image", alt: (@preview_photo.photo_dsc.presence || @preview_photo.filename) }

    .placard-subcards-grid
      -# Left Subcard: Work Identity & Curatorial Narrative (ITEM_FIELDS)
      .placard-subcard#placard-identity-card
        .card-header
          %h4.card-title Item Narrative

        .card-body
          %dl.detail-list
            - %i[title subtitle subject date_created_display location_display curatorial_notes].each do |field|
              - label_map = { title: "Title", subtitle: "Subtitle", subject: "Model", date_created_display: "Year", location_display: "Location", curatorial_notes: "Notes" }
              .detail-row{ class: ("detail-row-notes" if field == :curatorial_notes) }
                %dt= "#{label_map[field]}:"
                %dd{ class: placard_provenance_class(pd, field), title: placard_provenance_tooltip(pd, field) }
                  - val = pd.public_send(field)
                  - if val.present?
                    - if field == :curatorial_notes
                      = simple_format(val)
                    - else
                      = val
                  - else
                    %span.subdued —

      -# Right Subcard: Physical Specs, Pricing & Licensing (COLLECTION_FIELDS)
      .placard-subcard#placard-specs-card
        .card-header
          %h4.card-title Collection Metadata

        .card-body
          %dl.detail-list
            - %i[artist_name medium dimensions_display edition_info price sales_notes cc_license copyright_year copyright_holder].each do |field|
              - label_map = { artist_name: "Artist", medium: "Medium", dimensions_display: "Dimensions", edition_info: "Edition", price: "Price", sales_notes: "Sales Notes", cc_license: "CC License", copyright_year: "Copyright Year", copyright_holder: "Copyright Holder" }
              .detail-row
                %dt= "#{label_map[field]}:"
                %dd{ class: placard_provenance_class(pd, field), title: placard_provenance_tooltip(pd, field) }
                  - if field == :price
                    - formatted = format_placard_price(pd.price)
                    - if formatted.present?
                      = formatted
                    - else
                      %span.subdued —
                  - elsif field == :cc_license
                    = pd.cc_license_label
                  - else
                    - val = pd.public_send(field)
                    - if val.present?
                      = val
                    - else
                      %span.subdued —
