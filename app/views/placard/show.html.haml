-# app/views/placard/show.html.haml
- pd = @collection_placard_data
- is_exhibition = @collection.is_a?(Exhibition)
- talent_name = (@collection.respond_to?(:talent) ? @collection.talent&.talent_name : nil) || pd.subject.presence

.view-container#placard-show-view
  .placard-master-card
    .card-header-bar
      .header-left
        %h3.placard-collection-title= pd.name
        = link_to "« placards", placard_index_path, class: "header-back-link"
        - if @collection.placard.present?
          = link_to "edit", edit_placard_path(@collection.placard, target_type: @collection.class.name, target_id: @collection.id), class: "header-action-link"
        - else
          = link_to "edit", new_placard_path(target_type: @collection.class.name, target_id: @collection.id), class: "header-action-link"
        = link_to "show", target_placard_itemcard_path(@collection), class: "header-action-link"

      .header-right
        %span.collection-type-pill{ class: (is_exhibition ? "type-exhibition" : "type-portfolio") }
          = @collection.class.name
        - if talent_name.present?
          %span.collection-talent= "Talent: #{talent_name}"
        %span.item-count= "#{@item_entries.size} #{'placard'.pluralize(@item_entries.size)}"

    .placard-subcards-grid
      -# Left Subcard: Staging, Medium & Pricing
      .placard-subcard#placard-collection-primary
        .card-header
          %h4.card-title Specs & Pricing

        .card-body
          %dl.detail-list
            - %i[artist_name price medium dimensions_display edition_info sales_notes].each do |field|
              - label_map = { artist_name: "Artist", price: "Price", medium: "Medium", dimensions_display: "Dimensions", edition_info: "Edition", sales_notes: "Sales Notes" }
              .detail-row
                %dt= "#{label_map[field]}:"
                %dd{ class: placard_provenance_class(pd, field), title: placard_provenance_tooltip(pd, field) }
                  - if field == :price
                    - formatted = format_placard_price(pd.price)
                    - if formatted.present?
                      = formatted
                    - else
                      %span.subdued —
                  - else
                    - val = pd.public_send(field)
                    - if val.present?
                      = val
                    - else
                      %span.subdued —

      -# Right Subcard: Licensing & Collection Metadata
      .placard-subcard#placard-collection-secondary
        .card-header
          %h4.card-title Licensing & Notes

        .card-body
          %dl.detail-list
            - %i[cc_license copyright_year copyright_holder subtitle date_created_display location_display curatorial_notes].each do |field|
              - label_map = { cc_license: "CC License", copyright_year: "Copyright Year", copyright_holder: "Copyright Holder", subtitle: "Subtitle", date_created_display: "Year", location_display: "Location", curatorial_notes: "Notes" }
              .detail-row{ class: ("detail-row-notes" if field == :curatorial_notes) }
                %dt= "#{label_map[field]}:"
                %dd{ class: placard_provenance_class(pd, field), title: placard_provenance_tooltip(pd, field) }
                  - if field == :cc_license
                    = pd.cc_license_label
                  - else
                    - val = pd.public_send(field)
                    - if val.present?
                      - if field == :curatorial_notes
                        = simple_format(val)
                      - else
                        = val
                    - else
                      %span.subdued —

    .thumbnail-grid-wrapper
      - if @item_entries.empty?
        .empty-items-note
          %p No items have been curated into this #{@collection.class.name.downcase} yet.
      - else
        .placard-thumbnail-grid
          - @item_entries.each do |entry|
            - item    = entry[:item]
            - photo   = entry[:photo]
            - item_pd = entry[:placard_data]
            - override_specs = [(:medium if item_pd.direct?(:medium)), (:dimensions_display if item_pd.direct?(:dimensions_display))].compact.map { |f| item_pd.public_send(f) }.compact
            .placard-thumb-card
              = link_to target_placard_itemcard_path(item), class: "pseudo-placard-link", title: (item_pd.title.presence || "Inspect Placard Card") do
                .thumb-image-frame
                  - if photo
                    %img{ src: public_fn(photo.filename), class: "mini-thumb-img", alt: (item_pd.title.presence || photo.filename) }
                .mini-placard-text
                  .mini-title-group
                    .mini-title{ class: placard_provenance_class(item_pd, :title) }= item_pd.title.presence || "Untitled"
                    - if override_specs.any?
                      .mini-specs= override_specs.join(":  ")
                  - meta_parts = [format_placard_price(item_pd.price), item_pd.date_created_display].compact
                  - if meta_parts.any?
                    .mini-meta= safe_join(meta_parts, raw("&emsp;"))
