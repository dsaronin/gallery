-# app/views/placard/index.html.haml
.view-container#placards-index
  .view-header
    %h3.view-title Placards &emsp;
    = link_to "⊞", root_path, class: "header-home", title: "Dashboard"
    = link_to "+", new_placard_path, class: "header-fab", title: "New Standalone Placard"

  - if @collections.empty?
    .empty-state
      %p No Portfolios or Exhibitions are available for placard management.
      = link_to "Portfolios »", portfolio_index_path, class: "btn-card primary"
  - else
    .placard-collection-grid
      - @collections.each do |collection|
        = render partial: "placard/card", locals: { collection: collection }
