= form_for @showing, url: (@showing.persisted? ? showing_path(@showing) : showing_index_path), html: { class: "material-form" } do |f|
  - if @showing.errors.any?
    .form-error-panel
      %h5= "#{pluralize(@showing.errors.count, 'error')} prevented saving:"
      %ul
        - @showing.errors.full_messages.each do |message|
          %li= message

  .form-grid
    .form-field.full-width
      = f.label :title, "Showing Title *"
      = f.text_field :title, required: true, class: "form-input", placeholder: "e.g. Autumn Retrospective Run"

    .form-field
      = f.label :exhibition_id, "Exhibition"
      = f.collection_select :exhibition_id, @exhibitions, :id, :title, { include_blank: "— None (Unassigned) —" }, { class: "form-input form-select" }

    .form-field
      = f.label :venue_id, "Venue"
      = f.collection_select :venue_id, @venues, :id, :name, { include_blank: "— None (Unassigned) —" }, { class: "form-input form-select" }

    .form-field
      = f.label :start_date, "Start Date *"
      = f.date_field :start_date, required: true, class: "form-input"

    .form-field
      = f.label :end_date, "End Date *"
      = f.date_field :end_date, required: true, class: "form-input"

    - if @showing.persisted?
      .form-field
        = f.label :status, "Showing Status *"
        = f.select :status, Showing.statuses.keys.map { |s| [s.humanize, s] }, {}, { class: "form-input form-select" }

      .form-field
        = f.label :reception_date, "Reception Date & Time"
        = f.datetime_local_field :reception_date, class: "form-input"

      .form-field
        = f.label :prep_days, "Prep Days"
        = f.text_field :prep_days, inputmode: "numeric", pattern: "[0-9]*", class: "form-input", placeholder: "1"

      .form-field
        = f.label :teardown_days, "Teardown Days"
        = f.text_field :teardown_days, inputmode: "numeric", pattern: "[0-9]*", class: "form-input", placeholder: "1"

      .form-field
        = f.label :rental_cost, "Rental Cost ($)"
        = f.text_field :rental_cost, inputmode: "numeric", pattern: "[0-9]*", class: "form-input", placeholder: "0"

      .form-field
        = f.label :visitation_count, "Visitation Count"
        = f.text_field :visitation_count, inputmode: "numeric", pattern: "[0-9]*", class: "form-input", placeholder: "0"

      .form-field.full-width
        = f.label :notes, "Showing & Run Notes"
        = f.text_area :notes, rows: 4, class: "form-input form-textarea", placeholder: "Installation schedule, reception notes, press details..."

  .form-actions-bar
    = link_to "Cancel", (@showing.persisted? ? showing_path(@showing) : showing_index_path), class: "btn-cancel"
    = f.submit (@showing.persisted? ? "Update Showing »" : "Create Showing »"), class: "btn-submit"
