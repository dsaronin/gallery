= turbo_frame_tag "photo_tags_#{photo.id}" do
  .tags-wrapper
    - if photo.tags.empty?
      %span.no-tags-notice None yet…
    - else
      .tag-badges
        - photo.tags.includes(:category).order("categories.name, tags.name").each do |tag|
          %span.tag-badge
            %span.tag-category= "#{tag.category.name}:"
            %span.tag-name= tag.name
            = button_to "&#10008;".html_safe, remove_tag_photo_path(photo, tag_id: tag.id), method: :delete, class: "tag-remove-btn", title: "Remove #{tag.name}"

    - available = available_tags_for(photo)
    - if available.any?
      = form_with url: assign_tag_photo_path(photo), method: :post, class: "inline-tag-form" do |f|
        = f.grouped_collection_select :tag_id, Category.includes(:tags).order(:name), :tags, :name, :id, :name, { prompt: "Add tag...", selected: default_tag_id_for(photo, available) }, { class: "tag-select" }
        = f.submit "+ Add", class: "btn-tag-add"
