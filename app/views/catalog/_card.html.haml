- active_photos = catalog.photos.active_candidates
- unrated_count = catalog.photos.unrated.count
- preview_photo = catalog.photos.first

.catalog-card
  .card-header
    %h4.card-title= truncate(catalog.name, length: 28)
    - if gallery_state.current_catalog_id == catalog.id
      %span.badge-current Current

  .card-body
    .card-content-layout
      %dl.assoc-list
        .assoc-row
          %dt Total photos:
          %dd= catalog.photos.count
        .assoc-row
          %dt Active photos:
          %dd= active_photos.count
        .assoc-row
          %dt Unrated photos:
          %dd= unrated_count
        .assoc-row.assoc-path-row
          %dt Path:
          %dd
            %button.btn-copy{ type: "button", title: "Copy shell-escaped path", onclick: "navigator.clipboard.writeText('#{j(shell_escaped_path(catalog.fpath))}')" }
              %svg{ viewBox: "0 0 24 24", width: "16", height: "16", fill: "currentColor" }
                %path{ d: "M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm3 4H8C6.9 5 6 5.9 6 7v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" }
              %span.btn-copy-label copy »
      - if preview_photo
        .card-thumbnail-preview
          %a{ href: catalog_path(catalog), title: "Open #{catalog.fname}" }
            %img{ src: public_fn(preview_photo.filename), class: "image", alt: preview_photo.photo_dsc }

  .card-actions
    = link_to "View Catalog Photos »", catalog_path(catalog), class: "btn-card"
