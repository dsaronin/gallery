- active_photos = catalog.photos.active_candidates
- unrated_count = catalog.photos.unrated.count
- preview_photo = catalog.photos.first
- is_curated    = catalog.curated?

.catalog-card
  .card-header
    %h4.card-title= truncate(catalog.name, length: 28)
    .header-badges
      - if gallery_state.current_catalog_id == catalog.id
        %span.badge-current Current
      - if is_curated
        %span.badge-curated Curated

  .card-body
    .card-content-layout
      %dl.assoc-list
        .assoc-row
          %dt Total photos:
          %dd= catalog.photos.count
        .assoc-row
          %dt Active photos:
          %dd= active_photos.count
        .assoc-row
          %dt talent:
          %dd
            - if catalog.talent.present?
              = link_to catalog.talent.talent_name, talent_path(catalog.talent), class: "talent-pill"
            - else
              %span.subdued —
        .assoc-row.assoc-path-row
          %dt Path:
          %dd
            %button.btn-copy{ type: "button", title: "Copy shell-escaped path", onclick: "navigator.clipboard.writeText('#{j(shell_escaped_path(catalog.fpath))}')" }
              %svg{ viewBox: "0 0 24 24", width: "16", height: "16", fill: "currentColor" }
                %path{ d: "M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm3 4H8C6.9 5 6 5.9 6 7v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" }
              %span.btn-copy-label copy »
      - if preview_photo
        .card-thumbnail-preview
          %a{ href: catalog_path(catalog), title: "Open #{catalog.fname}" }
            %img{ src: public_fn(preview_photo.filename), class: "image", alt: preview_photo.photo_dsc }

  .card-actions
    = button_to catalog_path(catalog), method: :delete, disabled: is_curated, title: (is_curated ? "Cannot delete: catalog photos are referenced in a portfolio or exhibition" : "Delete catalog"), form: { data: { turbo_confirm: "Are you sure you want to delete catalog \"#{catalog.name}\"?" } }, onclick: (is_curated ? nil : "return confirm('Are you sure you want to delete catalog \"#{j(catalog.name)}\"?')"), class: "btn-card btn-card-delete #{'btn-disabled' if is_curated}" do
      Delete
      %span.clear-glyph ✘
    = link_to "+ Talent", talent_index_path(assign_to_catalog_id: catalog.id), class: "btn-card"
    = link_to "Show Photos »", catalog_path(catalog), class: "btn-card"
