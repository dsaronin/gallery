- is_curated = @catalog.curated?

.view-container#catalog-show-view
  .catalog-card
    .card-header-bar
      .header-left
        %h3.catalog-title= @catalog.name
        = link_to "« Catalogs", catalog_index_path, class: "header-back-link"

      .header-right
        - if is_curated
          %span.badge-curated Curated
        %span.photo-count= "#{@catalog.photos.size} #{'photo'.pluralize(@catalog.photos.size)}"
        %span.catalog-fpath= @catalog.fname

    .thumbnail-grid-wrapper
      .thumbnail-grid
        - @catalog.photos.each do |p|
          - is_cover = @catalog.talent.present? && @catalog.talent.cover_id == p.id
          .thumbnail{ class: ("is-talent-cover" if is_cover) }
            - if @catalog.talent.present?
              = button_to "", set_cover_talent_path(@catalog.talent, photo_id: p.id), method: :patch, class: "btn-cover-hit-area", title: (is_cover ? "Current talent cover" : "Click background to set as talent cover")
            %a{ href: url_for(p) }
              %img{ src: public_fn(p.filename), class: "image", alt: p.photo_dsc }
            = render partial: "photo/star_rating", locals: { photo: p }
            = link_to p.photo_dsc, p, class: "photo-desc-link"

    - if is_curated
      - portfolios  = @catalog.curated_portfolios
      - exhibitions = @catalog.curated_exhibitions
      .curated-usage-section
        %h5.usage-heading Curated References
        - if portfolios.any?
          .usage-group
            %span.usage-label Portfolios:
            .usage-links
              - portfolios.each do |portfolio|
                = link_to portfolio.title, portfolio_path(portfolio), class: "usage-link"
        - if exhibitions.any?
          .usage-group
            %span.usage-label Exhibitions:
            .usage-links
              - exhibitions.each do |exhibition|
                = link_to exhibition.title, exhibition_path(exhibition), class: "usage-link"


