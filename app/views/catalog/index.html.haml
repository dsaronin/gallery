.view-container#catalogs-index
  .view-header
    %h3.view-title Catalogs &emsp;
    = link_to "⊞", root_path, class: "header-home", title: "Dashboard"
    = link_to "+", catalog_selectcatalog_path, class: "header-fab", title: "Ingest New Catalog"

  - if @list.empty?
    .empty-state
      %p No catalogs have been started.
      = link_to "Select Catalogs to Ingest »", catalog_selectcatalog_path, class: "btn-card primary"
  - else
    .catalog-grid
      - @list.each do |catalog|
        = render partial: "catalog/card", locals: { catalog: catalog }
