%h4 Available Catalogs
%p
  = link_to "Select Catalogs to Ingest", catalog_selectcatalog_path, class: "btn"
%i click name to show all pics in catalog
.list
  - if @list.empty?
    %p There are no catalogs to show; select something to load.
  - else
    .column
      %ul
        - @list.each do |f|
          %li= link_to f.fname, f
