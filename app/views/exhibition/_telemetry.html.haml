%dl.assoc-list
  .assoc-row
    %dt Total:
    %dd= "#{metrics[:total_count]} #{'exhibition'.pluralize(metrics[:total_count])} (#{metrics[:draft_count]} draft)"
  .assoc-row
    %dt Scheduled:
    %dd= "#{metrics[:scheduled_count]} upcoming"
  .assoc-row
    %dt Active:
    %dd= "#{metrics[:active_count]} running (#{metrics[:completed_count]} completed)"
  .assoc-row
    %dt Current:
    %dd
      - if gallery_state.current_exhibition
        = link_to exhibition_path(gallery_state.current_exhibition) do
          = truncate(gallery_state.current_exhibition.title, length: 34)
          &raquo;
      - else
        %span.subdued none selected
