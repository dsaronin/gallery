-# app/views/exhibition/show.html.haml
.view-container#exhibition-show-view
  .exhibition-card
    .card-header-bar
      .header-left
        %h3.exhibition-title= @exhibition.title
        = link_to "« back", exhibition_index_path, class: "header-back-link"
        = link_to "edit", edit_exhibition_path(@exhibition), class: "header-action-link"
        - if @exhibition_items.any?
          = button_to clear_items_exhibition_path(@exhibition), method: :delete, form_class: "inline-action-form", data: { turbo_confirm: "Are you sure you want to remove all photos and reset curation criteria for this exhibition?" }, class: "header-action-link btn-link-action" do
            clear
            %span.clear-glyph ✘
        = link_to "curate »", exhibition_curation_path(@exhibition), class: "header-action-link"

      .header-right
        %span.exhibition-status-pill{ class: "status-#{@exhibition.status}" }= @exhibition.status.humanize
        %span.photo-count= "#{@exhibition_items.size} #{'photo'.pluralize(@exhibition_items.size)}"
        %span.exhibition-meta= @exhibition.sales_policy.humanize

    - if @exhibition_items.empty?
      .empty-items-state
        %p
          This exhibition does not contain any curated photos yet.
          = link_to "curate »", exhibition_curation_path(@exhibition), class: "header-action-link"
    - else
      .thumbnail-grid-wrapper
        .thumbnail-grid
          - @exhibition_items.each do |item|
            - p = item.photo
            .thumbnail{ id: dom_id(item) }
              %a{ href: url_for(p) }
                %img{ src: public_fn(p.filename), class: "image", alt: p.photo_dsc }
              = render partial: "photo/star_rating", locals: { photo: p }
              = link_to p.photo_dsc, p, class: "photo-desc-link"
