-# app/views/exhibition/show.html.haml
.view-container#exhibition-show-view
  .exhibition-card
    .card-header-bar
      .header-left
        %h3.exhibition-title= @exhibition.title
        = link_to "« exhibitions", exhibition_index_path, class: "header-back-link"
        = link_to "edit", edit_exhibition_path(@exhibition), class: "header-action-link"
        - if @exhibition_items.any?
          = link_to "pdf placards", download_placards_exhibition_path(@exhibition), class: "header-action-link", target: "_blank", rel: "noopener"
          = button_to clear_items_exhibition_path(@exhibition), method: :delete, form_class: "inline-action-form", form: { data: { turbo_confirm: "Are you sure you want to remove all photos and reset curation criteria for exhibition \"#{@exhibition.title}\"?" } }, onclick: "return confirm('Are you sure you want to remove all photos and reset curation criteria for exhibition \"#{j(@exhibition.title)}\"?')", class: "header-action-link btn-link-action" do
            clear
            %span.clear-glyph ✘
        = link_to "curate »", exhibition_curation_path(@exhibition), class: "header-action-link"

      .header-right
        %span.exhibition-status-pill{ class: "status-#{@exhibition.status}" }= @exhibition.status.humanize
        %span.photo-count= "#{@exhibition_items.size} #{'photo'.pluralize(@exhibition_items.size)}"
        %span.exhibition-meta= @exhibition.sales_policy.humanize

    - if @exhibition_items.empty?
      .empty-items-state
        %p
          This exhibition does not contain any curated photos yet.
          = link_to "curate »", exhibition_curation_path(@exhibition), class: "header-action-link"
    - else
      .thumbnail-grid-wrapper
        = render partial: "shared/collection_thumbnail_grid", locals: { collection: @exhibition, items: @exhibition_items }

