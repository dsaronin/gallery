-# app/views/shared/_copy_button.html.haml
-# Locals: text (String), title (String, optional), label (String, optional)
- btn_title = local_assigns.fetch(:title, "Copy to clipboard")
- btn_label = local_assigns.fetch(:label, "copy »")

%button.btn-copy{ type: "button", title: btn_title, onclick: "navigator.clipboard.writeText('#{j(text.to_s)}')" }
  %svg{ viewBox: "0 0 24 24", width: "16", height: "16", fill: "currentColor" }
    %path{ d: "M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm3 4H8C6.9 5 6 5.9 6 7v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" }
  %span.btn-copy-label= btn_label
