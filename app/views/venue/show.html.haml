-# app/views/venue/show.html.haml
.view-container#venue-show-view
  .venue-card
    .card-header-bar
      .header-left
        %h3.venue-title= @venue.name
        = link_to "« venues", venue_index_path, class: "header-back-link"
        = link_to "edit", edit_venue_path(@venue), class: "header-action-link"
        - if @venue.deletable?
          = button_to venue_path(@venue), method: :delete, form_class: "inline-action-form", form: { data: { turbo_confirm: "Are you sure you want to delete venue \"#{@venue.name}\"?" } }, onclick: "return confirm('Are you sure you want to delete venue \"#{j(@venue.name)}\"?')", class: "header-action-link btn-link-action" do
            delete
            %span.clear-glyph ✘

      .header-right
        %span.venue-status-pill{ class: "status-#{@venue.status}" }= @venue.status.humanize
        - if @venue.wall_linear_meters.present?
          %span.wall-capacity= "#{@venue.wall_linear_meters} m wall"
        %span.venue-meta= @venue.venue_type.humanize

    .venue-subcards-grid
      -# Left Card: Venue Information & Notes
      .venue-subcard#venue-info-card
        .card-header
          %h4.card-title Venue
          %span.header-badge= @venue.venue_type.humanize

        .card-body
          %dl.detail-list
            .detail-row
              %dt Showroom:
              %dd= @venue.space_name.presence || "—"
            .detail-row
              %dt Wall size:
              %dd= @venue.wall_linear_meters.present? ? "#{@venue.wall_linear_meters} (m)" : "—"
            .detail-row
              %dt Rate:
              %dd= @venue.rate_per_day.present? ? "$#{@venue.rate_per_day} / day" : "—"
            .detail-row.detail-row-notes
              %dt Notes:
              %dd
                - if @venue.notes.present?
                  = simple_format(@venue.notes)
                - else
                  %span.subdued —

      -# Right Card: Contact Information
      .venue-subcard#venue-contact-card
        .card-header
          %h4.card-title Contact
          %span.header-badge Coordinator

        .card-body
          %dl.detail-list
            .detail-row
              %dt Contact:
              %dd= @venue.contact_name.presence || "—"
            .detail-row
              %dt Position:
              %dd= @venue.contact_position.presence || "—"
            .detail-row
              %dt Email:
              %dd
                - if @venue.contact_email.present?
                  = mail_to @venue.contact_email
                - else
                  —
            .detail-row
              %dt Website:
              %dd
                - if @venue.website_url.present?
                  = link_to @venue.website_url, @venue.website_url, target: "_blank", rel: "noopener"
                - else
                  —
            .detail-row
              %dt Phone:
              %dd= @venue.contact_phone.presence || "—"
            .detail-row
              %dt Address:
              %dd= @venue.address.presence || "—"

    -# Reserved slot for v2 venue visuals (.thumbnail-grid)
    .venue-visuals-placeholder
