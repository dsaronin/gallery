#dashboard-container
  .dashboard-grid

    -# ----------------------------------------------------
    -# 1. CATALOGS CARD
    -# ----------------------------------------------------
    .dashboard-card#card-catalogs
      .card-header
        %h4.card-title Catalogs
        = link_to "+", catalog_selectcatalog_path, class: "card-fab", title: "New Catalog Ingestion"
      
      .card-body
        %dl.assoc-list
          .assoc-row
            %dt Ingested:
            %dd= "#{@metrics[:catalogs][:ingested_count]} of #{@metrics[:catalogs][:available_disk_count]} folders"
          .assoc-row
            %dt Indexed:
            %dd= "#{@metrics[:catalogs][:indexed_photos_count]} photos"
          .assoc-row
            %dt Current:
            %dd
              - if gallery_state.current_catalog
                = link_to catalog_path(gallery_state.current_catalog) do
                  = truncate(gallery_state.current_catalog.fname, length: 34)
                  &raquo;
              - else
                %span.subdued none selected

      .card-actions
        = link_to "All Catalogs", catalog_index_path, class: "btn-card"

    -# ----------------------------------------------------
    -# 2. PORTFOLIOS CARD
    -# ----------------------------------------------------
    .dashboard-card#card-portfolios
      .card-header
        %h4.card-title Portfolios
        = link_to "+", new_portfolio_path, class: "card-fab", title: "New Portfolio"

      .card-body
        %dl.assoc-list
          .assoc-row
            %dt Total:
            %dd= "#{@metrics[:portfolios][:total_count]} collections"
          .assoc-row
            %dt Status:
            %dd= "#{@metrics[:portfolios][:active_count]} active / #{@metrics[:portfolios][:draft_count]} draft"
          .assoc-row
            %dt Curated:
            %dd= "#{@metrics[:portfolios][:curated_photos_count]} photo links"

      .card-actions
        = link_to "All Portfolios", portfolio_index_path, class: "btn-card"
        - if gallery_state.current_portfolio
          = link_to "Open Current", portfolio_path(gallery_state.current_portfolio), class: "btn-card primary"

    -# ----------------------------------------------------
    -# 3. EXHIBITIONS CARD
    -# ----------------------------------------------------
    .dashboard-card#card-exhibitions
      .card-header
        %h4.card-title Exhibitions
        = link_to "+", "#", class: "card-fab", title: "Stage New Exhibition"

      .card-body
        %dl.assoc-list
          .assoc-row
            %dt Staged:
            %dd= "#{@metrics[:exhibitions][:staged_count]} exhibits"
          .assoc-row
            %dt Lifecycle:
            %dd= "#{@metrics[:exhibitions][:planning_count]} planning / #{@metrics[:exhibitions][:active_count]} active"

      .card-actions
        = link_to "All Exhibitions", "#", class: "btn-card"
        - if gallery_state.current_exhibition
          = link_to "Open Current", "#", class: "btn-card primary"

    -# ----------------------------------------------------
    -# 4. SHOWINGS CARD
    -# ----------------------------------------------------
    .dashboard-card#card-showings
      .card-header
        %h4.card-title Showings
        = link_to "+", "#", class: "card-fab", title: "Book Run"

      .card-body
        %dl.assoc-list
          .assoc-row
            %dt Next Date:
            %dd= "#{@metrics[:showings][:next_date]} (in #{@metrics[:showings][:days_remaining]} days)"
          .assoc-row
            %dt Next Venue:
            %dd= @metrics[:showings][:next_venue]
          .assoc-row
            %dt Booked:
            %dd= "#{@metrics[:showings][:booked_count]} scheduled runs"

      .card-actions
        = link_to "All Showings", "#", class: "btn-card"
        - if gallery_state.current_showing
          = link_to "Open Current", "#", class: "btn-card primary"

    -# ----------------------------------------------------
    -# 5. ADMIN CARD
    -# ----------------------------------------------------
    .dashboard-card#card-admin
      .card-header
        %h4.card-title Admin
        %span.header-badge Infrastructure

      .card-body
        %dl.assoc-list
          .assoc-row
            %dt Staging:
            %dd= "#{@metrics[:admin][:venues_count]} venues (#{@metrics[:admin][:total_wall_meters]}m wall capacity)"
          .assoc-row
            %dt Talent:
            %dd= "#{@metrics[:admin][:talents_count]} profiles registered"
          .assoc-row
            %dt Taxonomy:
            %dd= "#{@metrics[:admin][:categories_count]} categories / #{@metrics[:admin][:tags_count]} tags"

      .card-actions.admin-actions
        = link_to "Venues", "#", class: "btn-card"
        = link_to "Talents", talent_index_path, class: "btn-card"
        = link_to "Tags & Categories", tag_index_path, class: "btn-card"
