#dashboard-container
  .dashboard-grid

    -# ----------------------------------------------------
    -# 1. CATALOGS CARD
    -# ----------------------------------------------------
    .dashboard-card#card-catalogs
      .card-header
        %h4.card-title Catalogs
        = link_to "+", catalog_selectcatalog_path, class: "card-fab", title: "New Catalog Ingestion"
      
      .card-body
        = render 'catalog/telemetry', metrics: @metrics[:catalogs]

      .card-actions
        - if gallery_state.current_catalog
          = link_to "Continue", catalog_path(gallery_state.current_catalog), class: "btn-card primary"
        = link_to "Catalogs »", catalog_index_path, class: "btn-card"

    -# ----------------------------------------------------
    -# 2. PORTFOLIOS CARD
    -# ----------------------------------------------------
    .dashboard-card#card-portfolios
      .card-header
        %h4.card-title Portfolios
        = link_to "+", new_portfolio_path, class: "card-fab", title: "New Portfolio"

      .card-body
        = render 'portfolio/telemetry', metrics: @metrics[:portfolios]

      .card-actions
        - if gallery_state.current_portfolio
          = link_to "Continue", portfolio_path(gallery_state.current_portfolio), class: "btn-card primary"
        = link_to "Portfolios »", portfolio_index_path, class: "btn-card"

    -# ----------------------------------------------------
    -# 3. EXHIBITIONS CARD
    -# ----------------------------------------------------
    .dashboard-card#card-exhibitions
      .card-header
        %h4.card-title Exhibitions
        = link_to "+", new_exhibition_path, class: "card-fab", title: "Stage New Exhibition"

      .card-body
        = render 'exhibition/telemetry', metrics: @metrics[:exhibitions]

      .card-actions
        - if gallery_state.current_exhibition
          = link_to "Continue", exhibition_path(gallery_state.current_exhibition), class: "btn-card primary"
        = link_to "Exhibitions »", exhibition_index_path, class: "btn-card"

    -# ----------------------------------------------------
    -# 4. SHOWINGS CARD
    -# ----------------------------------------------------
    .dashboard-card#card-showings
      .card-header
        %h4.card-title Showings
        = link_to "+", "#", class: "card-fab", title: "Book Run"

      .card-body
        = render 'showing/telemetry', metrics: @metrics[:showings]

      .card-actions
        - if gallery_state.current_showing
          = link_to "Continue", "#", class: "btn-card primary"
        = link_to "Showings »", "#", class: "btn-card"

    -# ----------------------------------------------------
    -# 5. VENUE CARD
    -# ----------------------------------------------------
    .dashboard-card#card-admin
      .card-header
        %h4.card-title Venue…
        = link_to "+", new_venue_path, class: "card-fab", title: "New Venue"

      .card-body
        = render 'venue/telemetry', metrics: @metrics[:admin]

      .card-actions.admin-actions
        - if gallery_state.current_venue
          = link_to "Continue", venue_path(gallery_state.current_venue), class: "btn-card primary"
        = link_to "Venues »", venue_index_path, class: "btn-card"
        = link_to "Talents »", talent_index_path, class: "btn-card"
        = link_to "Tags »", tag_index_path, class: "btn-card"
